--- !u!114 &4285237113354551307
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1516517859357125648}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 98ca366ed95bf5647af36d9e9e797c53, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Members.KJY._01.Scripts.UI.BattleTutorial
  eventChannel: {fileID: 11400000, guid: 255dbbb0fc4fa004db455d8bf5ffff4b, type: 2}
  rollManager: {fileID: 1819734133}
  dicePointers:
  - {fileID: 1932891977}
  - {fileID: 1658741045}
  - {fileID: 1151351063}
  - {fileID: 1689225656}
  panel: {fileID: 5471358777176051620}
  helpButton: {fileID: 5973380768635092765}
  heading: {fileID: 8494043856883269018}
  description: {fileID: 290036822421057470}
  progress: {fileID: 6619598897018531342}
  openMotion: {fileID: 2905549719252824976}
  closeMotion: {fileID: 1999558934592908083}
  pageMotion: {fileID: 823904783601228327}
  steps:
  - title: "\uC774\uBC88 \uD134\uC5D0 \uC4F8 \uC2A4\uD0AC\uBD80\uD130 \uBCFC\uAE4C\uC694?"
    description: "\uC67C\uCABD \uC8FC\uC0AC\uC704\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C
      \uC62C\uB824\uBCF4\uC138\uC694.\n\uC2A4\uD0AC \uC124\uBA85\uACFC \uB204\uAD6C\uC5D0\uAC8C
      \uC4F8 \uC218 \uC788\uB294\uC9C0 \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694."
    advanceOn: 0
  - title: "\uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uC2A4\uD0AC\uC740 \uB0A8\uACA8\uB450\uC138\uC694"
    description: "\uC8FC\uC0AC\uC704 \uC544\uC774\uCF58\uC744 \uD558\uB098 \uD074\uB9AD\uD574
      \uC7A0\uAC00\uBCF4\uC138\uC694.\n\uC7A0\uADFC \uC8FC\uC0AC\uC704\uB294 \uB2E4\uC2DC
      \uAD74\uB824\uB3C4 \uBC14\uB00C\uC9C0 \uC54A\uC544\uC694.\n\uD55C \uBC88 \uB354
      \uB204\uB974\uBA74 \uC7A0\uAE08\uC774 \uD480\uB824\uC694."
    advanceOn: 1
  - title: "\uB2E4\uB978 \uC2A4\uD0AC\uB3C4 \uBF51\uC544\uBCFC\uAE4C\uC694?"
    description: "\uC624\uB978\uCABD \uC544\uB798 [\uB2E4\uC2DC \uAD74\uB9AC\uAE30]\uB97C
      \uB20C\uB7EC\uBCF4\uC138\uC694.\n\uC7A0\uADF8\uC9C0 \uC54A\uC740 \uC8FC\uC0AC\uC704\uB9CC
      \uBC14\uB00C\uC5B4\uC694.\n\uB300\uC2E0 \uC801\uB3C4 \uAC15\uD574\uC9C0\uB2C8,
      \uC704\uCABD \uC704\uD5D8\uB3C4\uB97C \uD655\uC778\uD574 \uC8FC\uC138\uC694."
    advanceOn: 2
  - title: "\uB204\uAD6C\uC5D0\uAC8C \uC2A4\uD0AC\uC744 \uC4F8\uAE4C\uC694?"
    description: "\uC67C\uCABD \uCE90\uB9AD\uD130\uB97C \uB204\uB974\uACE0, \uC2A4\uD0AC\uC744
      \uC4F8 \uB300\uC0C1\uC744 \uACE8\uB77C\uBCF4\uC138\uC694.\n\uACF5\uACA9\uC740
      \uC801\uC5D0\uAC8C, \uD68C\uBCF5\uACFC \uC9C0\uC6D0\uC740 \uC544\uAD70\uC5D0\uAC8C
      \uC4F8 \uC218 \uC788\uC5B4\uC694.\n\uC790\uC2E0\uC5D0\uAC8C \uC4F0\uB294 \uC2A4\uD0AC\uC740
      \uBC14\uB85C \uC5F0\uACB0\uB3FC\uC694."
    advanceOn: 3
  - title: "\uC774\uC81C \uC2F8\uC6CC\uBCFC\uAE4C\uC694?"
    description: "\uC624\uB978\uCABD \uC544\uB798 [\uC804\uD22C \uC2DC\uC791]\uC744
      \uB20C\uB7EC\uBCF4\uC138\uC694.\n\uC6B0\uB9AC \uD300\uC740 \uC5F0\uACB0\uD55C
      \uC21C\uC11C\uB300\uB85C \uD589\uB3D9\uD574\uC694.\n\uBCF4\uD638\uB098 \uAC15\uD654
      \uC2A4\uD0AC\uC744 \uBA3C\uC800 \uC5F0\uACB0\uD558\uBA74 \uB3C4\uC6C0\uC774
      \uB3FC\uC694."
    advanceOn: 4
