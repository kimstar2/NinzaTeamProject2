  m_Script: {fileID: 11500000, guid: 91c09f6f89b1d8ca95e4546715e4910a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Members.KJY._01.Scripts.UI.ForgeTutorial
  panel: {fileID: 5471358777794522173}
  helpButton: {fileID: 5973380768050175108}
  heading: {fileID: 8494043856302415363}
  description: {fileID: 290036822909881383}
  progress: {fileID: 6619598896429026711}
  nextLabel: {fileID: 3773764209700569072}
  openMotion: {fileID: 2905549719703900169}
  closeMotion: {fileID: 1999558935177939114}
  pageMotion: {fileID: 823904784186145214}
  showOnFirstVisit: 1
  pages:
  - title: "\uC7AC\uB828\uC774\uB780?"
    description: "\uC804\uD22C\uC5D0\uC11C \uC5BB\uC740 \uC8FC\uC0AC\uC704 \uBA74\uC744
      \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uCCAB \uBC88\uC9F8 \uCE78\uC5D0\uB294
      \uAC15\uD654\uD560 \uBA74,\n\uB098\uBA38\uC9C0 \uB450 \uCE78\uC5D0\uB294 \uC18C\uBAA8\uD560
      \uC7AC\uB8CC \uBA74\uC744 \uB123\uC2B5\uB2C8\uB2E4.\n\uC7AC\uB828\uC5D0\uB294
      \uACE8\uB4DC\uAC00 \uC18C\uBAA8\uB429\uB2C8\uB2E4."
  - title: "\uC2A4\uD0AC \uB4F1\uAE09"
    description: "\uB4F1\uAE09\uC740 \uC77C\uBC18 < \uD76C\uADC0 < \uC804\uC124\n\uC88B\uC740
      \uC7AC\uB8CC\uB97C \uB123\uC744\uC218\uB85D \uB354 \uAC15\uD55C \uC2A4\uD0AC\uC774
      \uB098\uC624\uAE30 \uC27D\uC2B5\uB2C8\uB2E4."
  - title: "\uC7AC\uB8CC \uB4F1\uAE09"
    description: "\uC7AC\uB8CC 2\uAC1C\uAC00 \uBAA8\uB450 \uAC15\uD654\uD560 \uBA74\uBCF4\uB2E4
      \uB0AE\uC740 \uB4F1\uAE09\uC774\uBA74 \uB808\uBCA8 +0.5\n\uC7AC\uB8CC 1\uAC1C\uB9CC
      \uAC19\uAC70\uB098 \uB192\uC740 \uB4F1\uAE09\uC774\uBA74 \uB808\uBCA8 +1\n\uB808\uBCA8\uC774
      \uC624\uB97C\uC218\uB85D \uC2A4\uD0AC \uD6A8\uACFC\uAC00 \uAC15\uD574\uC9D1\uB2C8\uB2E4.
      (\uCD5C\uB300 3)"
  - title: "\uB4F1\uAE09 \uC0C1\uC2B9"
    description: "\uC7AC\uB8CC 2\uAC1C\uAC00 \uBAA8\uB450 \uAE30\uC900 \uBA74\uACFC
      \uAC19\uAC70\uB098 \uB192\uC740 \uB4F1\uAE09\uC774\uBA74\n\uD55C \uB2E8\uACC4
      \uC704 \uB4F1\uAE09\uC758 \uC0C8\uB85C\uC6B4 \uC2A4\uD0AC\uB85C \uBC14\uB01D\uB2C8\uB2E4.
      \n\uB808\uBCA8\uC740 1\uB85C \uCD08\uAE30\uD654 \uB429\uB2C8\uB2E4.\n\uC804\uC124
      \uBA74\uC740 \uB4F1\uAE09 \uC0C1\uC2B9 \uB300\uC2E0 \uB808\uBCA8\uC774 1 \uC624\uB985\uB2C8\uB2E4."
