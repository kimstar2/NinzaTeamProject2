  choices: 4
  choiceText:
  - "\uC7A0\uAE50, \uC545\uC218 \uC548\uD574\uC904\uAC70\uC57C?"
  - "\uC65C \uB098\uB791 \uC545\uC218\uB97C \uD558\uACE0\uC2F6\uC9C0 \uC54A\uC544\uD558\uB294\uAC70\uC57C?"
  - "\uC774\uBD10, \uADF8\uB0E5 \uC545\uC218\uC77C \uBFD0\uC774\uC57C. \uD55C\uBC88\uCBE4\uC740
    \uD574\uC904 \uC218 \uC788\uC796\uC544."
  - "\uC545\uC218, \uD55C\uB2E4."
  resultText:
  - "\uBFCC\uC9C1!\\n\uADF8 \uD574\uACE8\uACFC \uC545\uC218\uD558\uC790\uB9C8\uC790,
    \uC815\uCCB4\uBD88\uBA85\uC758 \uBC29\uAD6C\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4.\\n\u201D\uD5E4,
    \uB098\uB791 \uC545\uC218\uD558\uB294\uAC74 \uC644\uC804 '\uC545\uC218'\uC600\uB124\u201D\\n\u2026
    \uC815\uB9D0 \uACE8\uB54C\uB9AC\uB294 \uCE5C\uAD6C\uAD6C\uB9CC.\\n\uC544\uBB34
    \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uB2E4."
  - "\uBFCC\uC9C1!\\n\uADF8 \uD574\uACE8\uACFC \uC545\uC218\uD558\uC790\uB9C8\uC790,
    \uC815\uCCB4\uBD88\uBA85\uC758 \uBC29\uAD6C\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4.\\n\u201D\uD5E4,
    \uB098\uB791 \uC545\uC218\uD558\uB294\uAC74 \uC644\uC804 '\uC545\uC218'\uC600\uB124\u201D\\n\u2026
    \uC815\uB9D0 \uACE8\uB54C\uB9AC\uB294 \uCE5C\uAD6C\uAD6C\uB9CC.\\n\uC544\uBB34
    \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uB2E4."
  - "\uBFCC\uC9C1!\\n\uADF8 \uD574\uACE8\uACFC \uC545\uC218\uD558\uC790\uB9C8\uC790,
    \uC815\uCCB4\uBD88\uBA85\uC758 \uBC29\uAD6C\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4.\\n\u201D\uD5E4,
    \uB098\uB791 \uC545\uC218\uD558\uB294\uAC74 \uC644\uC804 '\uC545\uC218'\uC600\uB124\u201D\\n\u2026
    \uC815\uB9D0 \uACE8\uB54C\uB9AC\uB294 \uCE5C\uAD6C\uAD6C\uB9CC.\\n\uC544\uBB34
    \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uB2E4."
  - "\uD574\uACE8\uC744 \uC9C0\uB098\uCE58\uB294 \uC21C\uAC04, \uC8C4\uC545\uC774
