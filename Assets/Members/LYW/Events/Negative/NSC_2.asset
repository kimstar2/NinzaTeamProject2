  EventTitle: "\uC5B4\uB450\uC6B4 \uB2EC \uC544\uB798 \uC794\uB514\uBC2D"
  EventExplain: "\uC5B4\u2026 \uADF8\uB0E5 \uC21C\uC218\uD558\uAC8C \uC5B4\uB450\uCEF4\uCEF4\uD55C
    \uC794\uB514\uBC2D \uD55C\uBCF5\uD310\uC5D0\uC11C \uAE38\uC744 \uC783\uC5B4\uBC84\uB838\uB2E4.
    \uC5B4\uB5BB\uAC8C \uD560\uAE4C?"
  backgroundImage: {fileID: -1011441080542184327, guid: f0c8af97afc18cd4abd8e6e5636c0a6e, type: 3}
  EXImage: {fileID: 0}
  exImageScale: 1
  exImageColor: {r: 1, g: 1, b: 1, a: 1}
  backGroundImageColor: {r: 0.23270428, g: 0.23270428, b: 0.23270428, a: 1}
  exImageMaterial: {fileID: 0}
  choices: 3
  choiceText:
  - "\uC77C\uB2E8 \uC55E\uC73C\uB85C \uAC77\uB294\uB2E4."
  - "\uAC00\uB9CC\uD788 \uC788\uB294\uB2E4."
  - "\uBAA8\uB4E0 \uAC83\uC740 \uC2E0\uC758 \uB73B\uB300\uB85C! \uC8FC\uC0AC\uC704\uB97C
    \uAD74\uB824 \uD589\uB3D9\uC744 \uACB0\uC815\uD55C\uB2E4."
  resultText:
  - "\uAE38\uC744 \uCC3E\uAE34 \uD588\uC9C0\uB9CC, \uCCB4\uB825 \uC18C\uBAA8\uB97C
    \uB108\uBB34 \uB9CE\uC774 \uD574\uBC84\uB838\uB2E4.\\n(\uB2E4\uC74C \uC804\uD22C\uC5D0\uC11C
    \uC544\uAD70\uC758 \uC704\uD5D8\uB3C4\uAC00 10% \uC99D\uAC00)"
  - "\uC9C0\uB098\uAC00\uB358 \uC554\uC0C1\uC778\uC774 \uAE38\uC744 \uC783\uC5C8\uB0D0
    \uBB3B\uB294\uB2E4. \uB098\uB294 \uADF8\uB807\uB2E4\uACE0 \uB2F5\uD588\uB2E4.
    \uADF8\uB7EC\uC790, \uC554\uC0C1\uC778\uC740 \uC8FC\uBCC0 \uB9C8\uC744\uB85C
    \uAC00\uB294 \uAE38\uC744 \uC54C\uB824\uC8FC\uC5C8\uB2E4.\\n\uC544\uBB34 \uC77C\uB3C4
    \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uB2E4."
  - "\uC774\uB7F0, \uAE38\uC744 \uB108\uBB34 \uBE59 \uB3CC\uC544\uBC84\uB838\uB2E4.
    \uCCB4\uB825 \uC18C\uBAA8\uB97C \uC5C4\uCCAD\uB098\uAC8C \uB9CE\uC774 \uD574\uBC84\uB838\uB2E4.\\n(\uB2E4\uC74C
    \uC804\uD22C\uC5D0\uC11C \uC544\uAD70\uC758 \uC704\uD5D8\uB3C4\uAC00 20% \uC99D\uAC00\uD55C
    \uC0C1\uD0DC\uB85C \uC2DC\uC791)"
