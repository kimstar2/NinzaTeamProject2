  m_EditorClassIdentifier: Assembly-CSharp::Members.LYW.Scripts.Event.EventDataSO
  EventTitle: "\uC640!"
  EventExplain: "\uB208 \uC55E\uC5D0 \uC5B4\uB5A4 \uD574\uACE8\uC774 \uB098\uD0C0\uB0AC\uB2E4.
    \uADF8 \uD574\uACE8\uC740 \uC804\uD22C\uD558\uB824\uB294 \uC758\uC9C0\uAC00 \uC5C6\uC5B4\uBCF4\uC778\uB2E4.\\n\u201D\uC774\uBD10,
    \uB098\uB791 \uC545\uC218\uD558\uC9C0 \uC54A\uC744\uB798?\u201D \uC5B4\uB5BB\uAC8C
    \uD560\uAE4C?"
  backgroundImage: {fileID: -1011441080542184327, guid: f0c8af97afc18cd4abd8e6e5636c0a6e, type: 3}
  EXImage: {fileID: 0}
  exImageScale: 9.7
  exImageColor: {r: 1, g: 1, b: 1, a: 1}
  backGroundImageColor: {r: 0.23270428, g: 0.23270428, b: 0.23270428, a: 1}
  exImageMaterial: {fileID: 0}
  choices: 2
  choiceText:
  - "\uC545\uC218\uD55C\uB2E4."
  - "\uBB34\uC2DC\uD558\uACE0 \uC9C0\uB098\uAC04\uB2E4."
  resultText:
  - "\uBFCC\uC9C1!\\n\uADF8 \uD574\uACE8\uACFC \uC545\uC218\uD558\uC790\uB9C8\uC790,
    \uC815\uCCB4\uBD88\uBA85\uC758 \uBC29\uAD6C\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4.\\n\u201D\uD5E4,
    \uB098\uB791 \uC545\uC218\uD558\uB294\uAC74 \uC644\uC804 '\uC545\uC218'\uC600\uB124\u201D\\n\u2026
    \uC815\uB9D0 \uACE8\uB54C\uB9AC\uB294 \uCE5C\uAD6C\uAD6C\uB9CC.\\n\uC544\uBB34
    \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uB2E4."
  - "\uD574\uACE8\uC744 \uC9C0\uB098\uCE58\uB294 \uC21C\uAC04, \uC8C4\uC545\uC774
    \uB4F1\uC744 \uD0C0\uACE0 \uC624\uB978\uB2E4.\\n(\uB2E4\uC74C \uC804\uD22C\uC5D0\uC11C
    \uB9AC\uB864\uB85C \uC778\uD55C \uC704\uD5D8\uB3C4\uAC00 10% \uCD94\uAC00\uB85C
    \uC0C1\uC2B9\uD55C\uB2E4.)"
