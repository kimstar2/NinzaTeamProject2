  - "\u201D\uAC10\uC0AC\uD569\uB2C8\uB2E4!!\u201D\\n\uC5EC\uC790\uC544\uC774\uB294
    \uB9C8\uC744\uAE4C\uC9C0 \uB370\uB824\uB2E4\uC900 \uB2F5\uB840\uB85C \uD30C\uD2F0\uC5D0
    \uCD95\uBCF5\uC744 \uAC78\uC5B4\uC8FC\uC5C8\uB2E4.\\n(\uB2E4\uC74C \uC804\uD22C\uBD80\uD130
