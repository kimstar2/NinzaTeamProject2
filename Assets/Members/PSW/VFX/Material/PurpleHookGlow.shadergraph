    "m_FunctionBody": "// Alpha-only Gaussian blur. The PNG stays flat; glow is generated here.\nfloat2 uv = (UV - 0.5) / max(1.0 - 2.0 * Padding, 0.5) + 0.5;\nfloat inside = step(0.0, uv.x) * step(uv.x, 1.0) * step(0.0, uv.y) * step(uv.y, 1.0);\nfloat core = SAMPLE_TEXTURE2D(Hook.tex, Hook.samplerstate, saturate(uv)).a * inside;\nfloat blur = 0.0;\nfloat totalWeight = 0.0;\nif (GlowStrength > 0.0 && GlowRadius > 0.0)\n{\n    [unroll] for (int y = -3; y <= 3; ++y)\n    {\n        [unroll] for (int x = -3; x <= 3; ++x)\n        {\n            float weight = exp(-0.5 * (x*x + y*y) / 2.25);\n            float2 p = uv + float2(x, y) * GlowRadius / 3.0;\n            float valid = step(0.0, p.x) * step(p.x, 1.0) * step(0.0, p.y) * step(p.y, 1.0);\n            blur += SAMPLE_TEXTURE2D(Hook.tex, Hook.samplerstate, saturate(p)).a * weight * valid;\n            totalWeight += weight;\n        }\n    }\n}\nfloat halo = pow(saturate(blur / max(totalWeight, 0.0001)), max(GlowSoftness, 0.25));\nhalo *= (1.0 - core) * max(GlowStrength, 0.0) * saturate(GlowColor.a);\nfloat coreAlpha = core * saturate(CoreColor.a);\nfloat coverage = saturate(coreAlpha + halo);\nColor = (CoreColor.rgb * max(CoreIntensity, 0.0) * coreAlpha + GlowColor.rgb * halo)\n      / max(coverage, 0.0001) * Tint.rgb;\nAlpha = coverage * saturate(Opacity) * saturate(Tint.a);\n"
}

