{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "1804762270d54b4796f2f71a40dc9eba",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Cyan Shard + Halo",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 260,
            "y": 100,
            "width": 170,
            "height": 130
        }
    },
    "m_Slots": [
        {
            "m_Id": "02fc28ef15914ffb83bbf260dacf674a"
        },
        {
            "m_Id": "ad8448e78a504724872e1347cb4cc3f8"
        },
        {
            "m_Id": "710782420fb94332a720b9c6c667525c"
        },
        {
            "m_Id": "24132222dc054b93afcbfc30be6d2454"
        },
        {
            "m_Id": "3abdca92175049eab4eec7c5557b758c"
        },
        {
            "m_Id": "ff9aa5b4fc8c4f4789d6892bd0a6eda1"
        },
        {
            "m_Id": "1e83f761e33444f5ae0c6afbb978675a"
        },
        {
            "m_Id": "25ef0bae0b7446158a323a30becff9a9"
        },
        {
            "m_Id": "9aec06c19fd34b699548e976ca966127"
        },
        {
            "m_Id": "817c32e029914a318b76d79b9454f80a"
        },
        {
            "m_Id": "be0690bc1cbc445fb0bd5a13be328cec"
        },
        {
            "m_Id": "da55821979bd4326ba5b450676528f3b"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CyanShard",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "float2 p = UV - 0.5;\nfloat q = abs(p.x) / max(ShardLength, 0.01);\nfloat taper = pow(saturate(1.0 - q), 0.85);\nfloat cw = max(ShardWidth * taper, 0.0001);\nfloat hw = max((ShardWidth + GlowWidth) * taper, 0.0001);\nfloat core = exp2(-4.0 * (p.y / cw) * (p.y / cw)) * pow(taper, 0.4);\nfloat halo = exp2(-3.0 * (p.y / hw) * (p.y / hw)) * pow(taper, 1.4);\nfloat edge = 1.0 - smoothstep(0.43, 0.5, abs(p.y));\ncore *= edge * saturate(CoreColor.a);\nhalo *= edge * saturate(GlowColor.a);\nfloat coverage = saturate(max(core, halo));\nColor = (CoreColor.rgb * max(CoreIntensity, 0.0) * core + GlowColor.rgb * max(GlowStrength, 0.0) * halo) * Tint.rgb / max(coverage, 0.0001);\nAlpha = coverage * saturate(Opacity) * saturate(Tint.a);\n"
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.UVNode",
